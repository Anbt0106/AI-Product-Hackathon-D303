# Sao chép file này thành .env rồi điền đúng MỘT provider.
# Không commit codebase/.env. File .env.example này không chứa secret.

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Hoặc dùng Anthropic: đổi AI_PROVIDER=anthropic và điền key dưới đây.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Tuỳ chọn
PORT=5173